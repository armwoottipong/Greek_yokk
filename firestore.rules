        nq[ids[2]]==q[ids[2]]-t[2] && nq[ids[3]]==q[ids[3]]-t[3] &&
        after.activeLotId == (needed==0 ? before.activeLotId : active) && after.zeroActiveIds == (needed==0 ? before.zeroActiveIds : []) &&
        after.lastStockInDay==dates.receiveDay && after.expiryDay==dates.expiryDay;
    }
function validMaterial(s,g,id) {
