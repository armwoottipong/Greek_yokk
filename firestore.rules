        take==t[0]+t[1]+t[2]+t[3] && after.stock==before.stock-take &&
        (row.shortage==0 || before.inventoryType=='packaging' || e[0]+e[1]+e[2]+e[3]==before.stock) &&
        nq.diff(q).affectedKeys().hasOnly(before.allocationIds) &&
