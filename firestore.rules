        l.totalCents == (m.pricesCents[o.platformId] + p[ids[0]]+p[ids[1]]+p[ids[2]]+p[ids[3]]+p[ids[4]]+p[ids[5]]+p[ids[6]]+p[ids[7]]+p[ids[8]]+p[ids[9]]+p[ids[10]]) * l.qty;
