        n.diff(b).affectedKeys().hasOnly(['stock','unitCost','packCostCents','lastStockInDay','expiryDay','lots','lotQty','zeroActiveIds','allocationIds','slotIds','activeLotId','revision','lastOpId','lastOpKind','lastOpIndex']) &&
        integer(n.stock,1,1000000000) && n.stock==b.stock+o.qtyQ && n.unitCost==roundedUnit(packageWeighted(b.stock,b.unitCost,o.qtyQ,o.unitCost)) &&
        numberIn(n.unitCost,0,100000) && n.packCostCents==o.packCostCents && n.lastStockInDay==o.receiveDay && n.expiryDay==999999 &&
        n.activeLotId==o.lotId && n.zeroActiveIds==[] &&
        n.lotQty.diff(b.lotQty).affectedKeys().hasOnly([o.lotId]) && n.lotQty[o.lotId]==b.lotQty[o.lotId]+o.qtyQ;
    }
function packageStockOperation(s,g,id,o) {
      let b=get(materialPath(s,g,o.materialId)).data;
      let n=getAfter(materialPath(s,g,o.materialId)).data;
      let root=rootAfter(s);
      let old=b.lots[o.lotId];
      let lot=n.lots[o.lotId];
      return writable(s,g) && o.keys().hasOnly(['schemaVersion','kind','status','opId','uid','createdAt','materialId','materialRevision','shopRevision','qtyQ','unitCost','packCostCents','receiveDay','note','lotId','beforeStockQ','beforeUnitCost','beforeLotQtyQ','beforeLot','beforeActiveLotId','beforeZeroActiveIds']) &&
        o.schemaVersion==2 && o.status=='committed' && o.opId==id && o.uid==request.auth.uid && o.createdAt==request.time &&
        integer(o.qtyQ,1,1000000000) && numberIn(o.unitCost,0,100000) && integer(o.packCostCents,0,1000000000) &&
        (integer(o.receiveDay,0,100000) || o.receiveDay==999999) && o.note is string && o.note.size()<=1000 &&
        b.lotIds.size()>0 && o.lotId==packageMaster(b) &&
        o.beforeStockQ==b.stock && o.beforeUnitCost==b.unitCost && o.beforeLotQtyQ==b.lotQty[o.lotId] && o.beforeLot==old &&
        o.beforeActiveLotId==b.activeLotId && o.beforeZeroActiveIds==b.zeroActiveIds &&
        n.lastOpId==id && n.lastOpKind=='package_stock_in' && root.lastOpId==id && root.lastOpKind=='package_stock_in' && root.revision==o.shopRevision &&
        n.lots.diff(b.lots).affectedKeys().hasOnly([o.lotId]) && n.lots.keys().toSet()==b.lots.keys().toSet() &&
        lot.diff(old).affectedKeys().hasOnly(['initialQtyQ','unitCost','packCostCents','receiveDay','expiryDay','sortKey','note']) &&
        integer(lot.initialQtyQ,0,9007199254740991) && lot.initialQtyQ==old.initialQtyQ+o.qtyQ &&
        numberIn(lot.unitCost,0,100000) && lot.unitCost==packageWeighted(b.lotQty[o.lotId],old.unitCost,o.qtyQ,o.unitCost) &&
        lot.packCostCents==o.packCostCents && lot.receiveDay==o.receiveDay && lot.expiryDay==999999 &&
        lot.sortKey==999999*1000000000+o.receiveDay*1000+old.ordinal &&
        lot.note==(o.note=='' ? old.note : old.note=='' ? o.note : old.note+'; '+o.note);
    }
function packageStockRoot(s) {
      let b=resource.data;
      let n=request.resource.data;
      let o=getAfter(operationPath(s,b.generation,n.lastOpId)).data;
      return signedIn() && b.status=='active' && n.diff(b).affectedKeys().hasOnly(['revision','lastOpId','lastOpKind']) &&
        n.revision==b.revision+1 && o.kind=='package_stock_in' && o.opId==n.lastOpId && o.uid==request.auth.uid && o.shopRevision==n.revision &&
        validIndex(getAfter(materialPath(s,b.generation,o.materialId)).data);
    }
function platformProofPath(s,g,id,i) { return /databases/$(database)/documents/shops/$(s)/generations/$(g)/preparedPlatforms/$(id)/columnProofs/$(string(i)); }
function inventoryProofPath(s,g,id,i,j) { return /databases/$(database)/documents/shops/$(s)/generations/$(g)/preparedInventory/$(id)/steps/$(string(i))/proofs/$(string(j)); }
function preparationPath(s,g,id,kind) {
      let prefix=kind=='sale_set' ? 'sale_' : kind=='platform' ? 'platform_' : 'inventory_';
      return /databases/$(database)/documents/shops/$(s)/generations/$(g)/preparations/$(prefix+id);
    }
function preparationReceipt(s,g,m) { return m.kind=='sale_set' ? orderPath(s,g,m.opId) : operationPath(s,g,m.opId); }
function preparationCritical(s,g,m) {
      return m.kind=='sale_set' ? preparedPath(s,g,m.opId,'0') : m.kind=='platform' ? platformProofPath(s,g,m.opId,m.proofCount-1) : inventoryProofPath(s,g,m.opId,m.stepCount-1,m.proofCount-1);
    }
function preparationCreate(s,g,id,m) {
      return active(s,g) && m.keys().hasOnly(['kind','opId','uid','state','createdAt','lifetimeDays','proofCount','stepCount','materialCount']) &&
        m.kind in ['sale_set','inventory_batch','platform'] && m.opId is string && m.opId.matches('^[A-Za-z0-9_-]{1,200}$') &&
        id==(m.kind=='sale_set' ? 'sale_' : m.kind=='platform' ? 'platform_' : 'inventory_')+m.opId &&
        m.uid==request.auth.uid && m.state=='open' && m.createdAt==request.time && m.lifetimeDays==7 && !exists(preparationReceipt(s,g,m)) &&
        (m.kind=='inventory_batch' ? integer(m.stepCount,1,6) && integer(m.materialCount,1,6) && m.proofCount==m.materialCount*3 :
          m.stepCount==0 && m.materialCount==0 && integer(m.proofCount,1,m.kind=='sale_set'?3:32));
    }
function preparationClose(s,g) {
      let b=resource.data;
      let n=request.resource.data;
      let receipt=preparationReceipt(s,g,b);
      return active(s,g) && b.state=='open' && n.diff(b).affectedKeys().hasOnly(['state','closedAt']) && n.closedAt==request.time &&
        (n.state=='committed' ? request.auth.uid==b.uid && getAfter(receipt).data.kind==b.kind && getAfter(receipt).data.opId==b.opId && getAfter(receipt).data.uid==b.uid :
          ((n.state=='abandoned' && request.auth.uid==b.uid) || (n.state=='expired' && request.time>=b.createdAt+duration.value(7,'d'))) &&
          (!existsAfter(receipt) || getAfter(receipt).data.kind!=b.kind || getAfter(receipt).data.uid!=b.uid) && !existsAfter(preparationCritical(s,g,b)));
    }
function preparationCleanup(s,g,id,kind,retainCommitted) {
      let m=getAfter(preparationPath(s,g,id,kind)).data;
      return active(s,g) && m.kind==kind && m.opId==id && m.state in ['abandoned','expired','committed'] &&
        (!retainCommitted || m.state!='committed') && (m.uid==request.auth.uid || request.time>=m.createdAt+duration.value(7,'d'));
    }
function preparationCleanupProof(s,g,id,kind,index,step) {
      let m=getAfter(preparationPath(s,g,id,kind)).data;
      let i=int(index);
      return preparationCleanup(s,g,id,kind,false) && string(i)==index && integer(i,0,m.proofCount-1) &&
        (kind!='inventory_batch' || integer(int(step),0,m.stepCount-1) && string(int(step))==step);
    }

 match /shops/greek-yogg {
  allow get: if signedIn();
  allow update: if request.resource.data.lastOpKind=='sale_set' && validRoot('greek-yogg');
  allow update: if request.resource.data.lastOpKind=='stock_in' && stockRoot('greek-yogg');
  allow update: if request.resource.data.lastOpKind=='package_stock_in' && packageStockRoot('greek-yogg');
  allow update: if request.resource.data.lastOpKind=='produce' && produceRoot('greek-yogg');
  allow update: if request.resource.data.lastOpKind=='cancel' && cancelRoot('greek-yogg');
  match /generations/{g}/operations/{id} {
   allow read: if active('greek-yogg',g);
   allow create: if request.resource.data.kind=='stock_in' && stockOperation('greek-yogg',g,id,request.resource.data);
   allow create: if request.resource.data.kind=='package_stock_in' && packageStockOperation('greek-yogg',g,id,request.resource.data);
   allow create: if request.resource.data.kind=='produce' && produceOperation('greek-yogg',g,id,request.resource.data);
   allow create: if request.resource.data.kind=='cancel' && cancelOperation('greek-yogg',g,id,request.resource.data);
  }
  match /generations/{g}/preparations/{id} {
   allow read: if active('greek-yogg',g);
   allow create: if request.resource.data.kind=='sale_set' && preparationCreate('greek-yogg',g,id,request.resource.data);
   allow update: if preparationClose('greek-yogg',g);
  }
  match /generations/{g}/preparedSales/{id}/lineProofs/{index} {
   allow read: if active('greek-yogg',g);
   allow create: if request.resource.data.lines.size()==1 && preparedWrite('greek-yogg',g,id,index,request.resource.data);
   allow update: if resource.data.uid==request.auth.uid && preparedWrite('greek-yogg',g,id,index,request.resource.data);
   allow delete: if preparationCleanupProof('greek-yogg',g,id,'sale_set',index,'0');
  }
  match /generations/{g}/orders/{id} {
   allow read: if active('greek-yogg',g);
   allow create: if validOrder('greek-yogg',g,id,request.resource.data);
   allow update: if cancelOrder('greek-yogg',g,id);
  }
  match /generations/{g}/materials/{id} {
   allow read: if active('greek-yogg',g);
   allow update: if request.resource.data.lastOpKind=='sale_set' && validMaterial('greek-yogg',g,id);
   allow update: if request.resource.data.lastOpKind=='stock_in' && stockMaterial('greek-yogg',g,id);
   allow update: if request.resource.data.lastOpKind=='package_stock_in' && packageStockMaterial('greek-yogg',g,id);
   allow update: if request.resource.data.lastOpKind=='cancel' && cancelMaterial('greek-yogg',g,id);
   allow update: if request.resource.data.lastOpKind=='produce' && request.resource.data.lastOpIndex<2 && produceInput('greek-yogg',g,id);
   allow update: if request.resource.data.lastOpKind=='produce' && request.resource.data.lastOpIndex==2 && produceOutput('greek-yogg',g,id);
  }
  match /generations/{g}/display/{id} { allow read: if active('greek-yogg',g); }
  match /generations/{g}/legacyRecords/{id} { allow read: if active('greek-yogg',g); }
 }
 match /{document=**} { allow read,write: if false; }
}
}
