function active(s,g) { return signedIn() && get(rootPath(s)).data.status == 'active' && get(rootPath(s)).data.generation == g; }
function writable(s,g) { let root=rootAfter(s); return signedIn() && root.status == 'active' && root.generation == g; }
function actualLineBasic(l) {
