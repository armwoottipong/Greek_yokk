        o.lines is list && integer(o.lines.size(),1,6) && validLineCache(o) && o.lineWitnessCount == int((o.lines.size() + 1) / 2) &&
        o.materialIds == root.catalog.summaryMaterials && o.materialIds.toSet().size() == o.materialIds.size() && o.inventory.size() in [15,16] && o.inventory.size() == o.materialIds.size() &&
        o.approvedShortages.keys().hasOnly(o.materialIds) && o.approvedShortages.keys().size() == o.materialIds.size() &&
        o.materialIds.size() + o.lineWitnessCount + 2 <= 20 && platform.active && o.platformRevision == platform.revision &&
