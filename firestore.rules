      let count=g.allowRepeat ? selectionCount(q) : l.optionIds.size();
      let extra=g.pricingMode=='included' ? 0 : g.allowRepeat ? groupExtra(g.optionPrices[o.platformId],c.addonPrices[o.platformId],l.optionIds,q) : groupUnitExtra(g.optionPrices[o.platformId],c.addonPrices[o.platformId],l.optionIds.concat(['_','_','_','_','_','_','_','_','_','_','_']));
      return l.catalog==m && l.group==g && m.active && g.active &&
