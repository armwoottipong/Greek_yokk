      return menus[ids[0]]*qty[0]+menus[ids[1]]*qty[1]+menus[ids[2]]*qty[2]+menus[ids[3]]*qty[3]+menus[ids[4]]*qty[4]+menus[ids[5]]*qty[5]+
        r[choices.A0]*q.A0+r[choices.A1]*q.A1+r[choices.A2]*q.A2+r[choices.A3]*q.A3+r[choices.A4]*q.A4+r[choices.A5]*q.A5+
        r[choices.A6]*q.A6+r[choices.A7]*q.A7+r[choices.A8]*q.A8+r[choices.A9]*q.A9+r[choices.A10]*q.A10;
