      "html": "<div class=\"ds-choice-cards\" role=\"radiogroup\" aria-label=\"วิธีชำระเงิน\"><label class=\"ds-choice-card\"><span class=\"ds-choice-control\"><input type=\"radio\" name=\"ds-payment\" value=\"QR PromptPay\" checked><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" aria-hidden=\"true\"><path d=\"m20 6-11 11-5-5\"/></svg></span><span>QR<small>PromptPay</small></span></label><label class=\"ds-choice-card\"><span class=\"ds-choice-control\"><input type=\"radio\" name=\"ds-payment\" value=\"เงินสด\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" aria-hidden=\"true\"><path d=\"m20 6-11 11-5-5\"/></svg></span><span>เงินสด<small>Cash</small></span></label><label class=\"ds-choice-card\"><span class=\"ds-choice-control\"><input type=\"radio\" name=\"ds-payment\" value=\"Platform Delivery\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" aria-hidden=\"true\"><path d=\"m20 6-11 11-5-5\"/></svg></span><span>Platform<small>Delivery</small></span></label></div>",
