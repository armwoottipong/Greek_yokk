      "html": "<div class=\"ds-price-grid\"><div><label class=\"ds-affix-label\" for=\"ds-price-shop\">หน้าร้าน</label><span class=\"ds-affix-field\"><span>฿</span><input id=\"ds-price-shop\" type=\"number\" min=\"0\" step=\"any\" value=\"120\"></span></div><div><label class=\"ds-affix-label\" for=\"ds-price-delivery\">Delivery Platform</label><span class=\"ds-affix-field\"><span>฿</span><input id=\"ds-price-delivery\" type=\"number\" min=\"0\" step=\"any\" value=\"150\"></span></div></div>",
