rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Candidate for a bounded synthetic security proof only. Never deploy this
    // file: the production rules file continues to deny every client request.
    function shopPath(s) { return /databases/$(database)/documents/shops/$(s); }
    function base(s,g) { return /databases/$(database)/documents/shops/$(s)/generations/$(g); }
    function shop(s) { return get(shopPath(s)).data; }
    function signedIn() { return request.auth != null; }
    function active(s,g) { return signedIn() && shop(s).status == 'active' && shop(s).generation == g; }
    function writable(s,g) {
      let meta = getAfter(shopPath(s)).data;
      return signedIn() && meta.status == 'active' && meta.generation == g;
    }
    function orderPath(s,g,id) { return /databases/$(database)/documents/shops/$(s)/generations/$(g)/orders/$(id); }
    function materialPath(s,g,id) { return /databases/$(database)/documents/shops/$(s)/generations/$(g)/materials/$(id); }
    function catalog(s,g) { return getAfter(shopPath(s)).data.catalog; }
    function boundedInt(n, low, high) { return n is int && n >= low && n <= high; }
    function min(a,b) { return a < b ? a : b; }
    function roundHundred(n) { return int((n + 50) / 100); }
    function selectedPrice(l,i) {
      let choices = l.options;
      return choices.size() > i ? choices[i].unitPriceCents * choices[i].qty : 0;
    }
    function selectedQty(l,i,id) {
      let choices = l.options;
      return choices.size() > i ? choices[i].definition.recipe.get(id,0) * choices[i].qty : 0;
    }
    function requiredForLine(l,id) {
      let options = l.options;
      return (l.catalog.recipe.get(id,0) +
        (options.size() > 0 ? options[0].definition.recipe.get(id,0) * options[0].qty : 0) +
        (options.size() > 1 ? options[1].definition.recipe.get(id,0) * options[1].qty : 0)) * l.qty;
    }
    function validChoice(m,c,ids,platform) {
      let group = m.groups[c.groupId];
      return c.keys().hasOnly(['groupId','addonId','qty','definition','unitPriceCents']) &&
        boundedInt(c.qty,1,99) && c.groupId in m.groupIds &&
        (group.repeat || c.qty == 1) &&
        c.definition == group.options[c.addonId] &&
        c.unitPriceCents == (group.included ? 0 : c.definition.pricesCents[platform]) &&
        c.definition.recipe.keys().hasOnly(ids);
    }
    function groupCount(l,id) {
      let choices = l.options;
      return (choices.size() > 0 && choices[0].groupId == id ? choices[0].qty : 0) +
        (choices.size() > 1 && choices[1].groupId == id ? choices[1].qty : 0);
    }
    function validGroup(m,l,id) {
      let group = m.groups[id];
      let count = l.options.size() == 0 ? 0 : groupCount(l,id);
      return count >= group.min && count <= group.max;
    }
    function validAssignedGroup(m,l,i) {
      return m.groupIds.size() <= i || validGroup(m,l,m.groupIds[i]);
    }
    function validLineGroups(l) {
      let choices = l.options;
      let a = choices.size() > 0 ? choices[0] : {'groupId':'','qty':0};
      let b = choices.size() > 1 ? choices[1] : {'groupId':'','qty':0};
      return l.note is string && l.note.size() <= 1000 &&
        validGroupSlot(l.catalog,a,b,0) && validGroupSlot(l.catalog,a,b,1) &&
        validGroupSlot(l.catalog,a,b,2) && validGroupSlot(l.catalog,a,b,3);
    }
    function validGroupSlot(m,a,b,i) {
      return i >= m.groupIds.size() || validGroupPair(m.groups[m.groupIds[i]],m.groupIds[i],a,b);
    }
    function validGroupPair(group,id,a,b) {
      let count = (a.groupId == id ? a.qty : 0) + (b.groupId == id ? b.qty : 0);
      return count >= group.min && count <= group.max;
    }
    function splitGroups(o) { return o.lines.size() > 4 && o.multiIds.size() > 0; }
    function validGroupsAt(o,i) { return i >= o.lines.size() || validLineGroups(o.lines[i]); }
    function validLine(m,l,ids,platform,checkGroups) {
      return l.keys().hasOnly(['menuId','menuRevision','qty','options','totalCents','catalog','note']) &&
        l.catalog == m && m.active && l.menuRevision == m.revision && boundedInt(l.qty,1,1000000) && m.groupIds.size() <= 4 &&
        m.recipe.keys().hasOnly(ids) && l.options is list && l.options.size() <= 2 &&
        (l.options.size() < 1 || validChoice(m,l.options[0],ids,platform)) &&
        (l.options.size() < 2 || validChoice(m,l.options[1],ids,platform)) &&
        (l.options.size() < 2 || l.options[0].groupId != l.options[1].groupId || l.options[0].addonId != l.options[1].addonId) &&
        (!checkGroups || validLineGroups(l)) &&
        l.totalCents == (m.pricesCents[platform] + selectedPrice(l,0) + selectedPrice(l,1)) * l.qty;
    }
    function validLot(before,after,take,inUse) {
      return after.diff(before).affectedKeys().hasOnly(['qty','isInUse']) && after.qty == before.qty - take &&
        after.isInUse == inUse && boundedInt(after.qty,0,1000000000);
    }
    function available(l,day) { return l.expiryDay >= day ? l.qty : 0; }
    function firstLot(lots) {
      let a = lots[0];
      let b = lots[1];
      return (a.isInUse != b.isInUse ? a.isInUse :
        a.expiryDay != b.expiryDay ? a.expiryDay < b.expiryDay : a.receiveDay <= b.receiveDay) ? 0 : 1;
    }
    function takeAt(m,need,day,i) {
      let first = firstLot(m.lots);
      let remaining = need - min(need,available(m.lots[first],day));
      return min(available(m.lots[i],day),i == first ? need : remaining);
    }
    function complexStock(o) { return o.lines.size() > 4 && o.lineBlockSize == 1; }
    function validInventory(s,g,o,i,need) {
      let row = o.inventory[i];
      let before = resource.data;
      let after = request.resource.data;
      let lots = before.lots;
      let day = int((request.time + duration.value(7,'h')).date().toMillis() / 86400000);
      let first = firstLot(lots);
      let take0 = first == 0 ? min(need,available(lots[0],day)) :
        min(need-min(need,available(lots[1],day)),available(lots[0],day));
      let take1 = first == 0 ? min(need-take0,available(lots[1],day)) : min(need,available(lots[1],day));
      let shortage = need-take0-take1;
      let activeIndex = available(after.lots[first],day) > 0 ? first : available(after.lots[1-first],day) > 0 ? 1-first : -1;
      return (complexStock(o) || validStockFacts(o,row,after,i)) && row.needed == need && row.take0 == take0 && row.take1 == take1 &&
        (shortage == 0 || before.inventoryType == 'packaging' ||
          (available(lots[0],day) == lots[0].qty && available(lots[1],day) == lots[1].qty)) &&
        after.diff(before).affectedKeys().hasOnly(['stock','revision','lastOpId','lastOpKind','lastOpIndex','lots','activeLotId']) &&
        after.revision == before.revision + 1 && after.lastOpId == o.opId &&
        after.stock == before.stock-take0-take1 && after.lots.size() == 2 &&
        after.activeLotId == (activeIndex >= 0 ? lots[activeIndex].id : '') &&
        validLot(lots[0],after.lots[0],take0,activeIndex == 0) && validLot(lots[1],after.lots[1],take1,activeIndex == 1);
    }
    function requiredAt(lines,i,id) { return i < lines.size() ? requiredForLine(lines[i],id) : 0; }
    function packageNeed(o,id) {
      let lines = o.lines;
      let baseline = requiredAt(lines,0,id) + requiredAt(lines,1,id) + requiredAt(lines,2,id) +
        requiredAt(lines,3,id) + requiredAt(lines,4,id) + requiredAt(lines,5,id);
      let requested = baseline + o.packaging.get(id,{'adjustment':0}).adjustment;
      return requested > 0 ? requested : 0;
    }
    function finalMultiNeed(s,g,o,id) {
      let line = getAfter(linePath(s,g,o.opId,string(o.lineWitnessCount - 1))).data;
      let requested = line.multiNeeds[id] + o.packaging.get(id,{'adjustment':0}).adjustment;
      return requested > 0 ? requested : 0;
    }
    function linkedMaterialTwo(s,g,o,i) {
      let row = o.inventory[i];
      let after = getAfter(materialPath(s,g,o.materialIds[i])).data;
      return after.lots.size() == 2 && !('four' in row) && row.materialId == o.materialIds[i] && after.id == row.materialId &&
        !(row.materialId in o.multiIds) &&
        after.revision == row.revision + 1 && after.lastOpId == o.opId && after.lastOpKind == 'sale' && !after.deleted && validPackageFor(o,after,row.materialId) &&
        (!complexStock(o) || validStockFacts(o,row,after,i)) &&
        row.ingredientCostBaht == (after.inventoryType == 'ingredient' ? (row.needed / 100.0) * after.unitCost : 0) &&
        row.packagingCostCents == (after.inventoryType == 'packaging' ? int((((row.take0 + row.take1) / 100.0) * after.unitCost) * 100.0 + 0.5) : 0);
    }
    function paddedFour(lots) { return lots.size() == 3 ? lots.concat([{'id':'','qty':0,'isInUse':false,'expiryDay':999999,'receiveDay':999999}]) : lots; }
    function validHistoryWindow(before,after,row) {
      let offset = row.four.offset;
      let end = offset + 4;
      let window = before.lots[offset:end];
      return boundedInt(offset,0,before.lots.size() - 4) &&
        before.stock == window[0].qty + window[1].qty + window[2].qty + window[3].qty &&
        (offset == 0 || before.lots[0:offset] == after.lots[0:offset]) &&
        (end == before.lots.size() || before.lots[end:before.lots.size()] == after.lots[end:before.lots.size()]);
    }
    function fourBefore(lots,a,b) {
      let x = lots[a];
      let y = lots[b];
      return x.isInUse != y.isInUse ? x.isInUse : x.expiryDay != y.expiryDay ? x.expiryDay < y.expiryDay :
        x.receiveDay != y.receiveDay ? x.receiveDay < y.receiveDay : a < b;
    }
    function fourSum(q) { return q[0] + q[1] + q[2] + q[3]; }
    function linkedMaterialFour(s,g,o,i,kind) { return 'offset' in o.inventory[i].four ? linkedMaterialFourWindow(s,g,o,i,kind) : linkedMaterialFourBase(s,g,o,i,kind); }
    function linkedMaterialFourBase(s,g,o,i,kind) {
      let row = o.inventory[i];
      let f = row.four;
      let path = materialPath(s,g,o.materialIds[i]);
      let before = get(path).data;
      let after = getAfter(path).data;
      let order = f.order;
      let oldLots = paddedFour(before.lots);
      let newLots = after.lots.size() == 3 ? after.lots.concat([oldLots[3]]) : after.lots;
      let day = int((request.time + duration.value(7,'h')).date().toMillis() / 86400000);
      let active = fourActive(newLots,order,day);
      return after.lots.size() == before.lots.size() && newLots.size() == 4 && row.keys().hasOnly(['materialId','revision','needed','lot0Id','lot1Id','take0','take1','shortage','ingredientCostBaht','packagingCostCents','costRank','four']) &&
        f.keys().hasOnly(['ids','order','takes']) &&
        (kind != 'sale' || row.materialId in o.multiIds) &&
        (o.lines.size() <= 4 || row.needed == finalMultiNeed(s,g,o,row.materialId)) &&
        f.ids == [oldLots[0].id,oldLots[1].id,oldLots[2].id,oldLots[3].id] &&
        order.size() == 4 && order.toSet().size() == 4 && order.hasOnly([0,1,2,3]) && f.takes.size() == 4 &&
        row.materialId == o.materialIds[i] && before.id == row.materialId && !before.deleted &&
        row.revision == before.revision && after.lastOpId == o.opId && after.lastOpKind == kind &&
        row.costRank == before.costRank && (i == 0 || o.inventory[i - 1].costRank < row.costRank) &&
        row.lot0Id == f.ids[0] && row.lot1Id == f.ids[1] && row.take0 == f.takes[0] && row.take1 == f.takes[1] &&
        boundedInt(row.needed,0,1000000000) && row.shortage == row.needed - fourSum(f.takes) && o.approvedShortages[row.materialId] == row.shortage &&
        row.ingredientCostBaht == (before.inventoryType == 'ingredient' ? (row.needed / 100.0) * before.unitCost : 0) &&
        row.packagingCostCents == (before.inventoryType == 'packaging' ? int(((fourSum(f.takes) / 100.0) * before.unitCost) * 100.0 + 0.5) : 0) && validPackageFor(o,before,row.materialId) &&
        after.activeLotId == (active >= 0 ? oldLots[active].id : '') &&
        newLots[0].isInUse == (active == 0) && newLots[1].isInUse == (active == 1) &&
        validLot(oldLots[2],newLots[2],f.takes[2],active == 2) && validLot(oldLots[3],newLots[3],f.takes[3],active == 3);
    }
    function linkedMaterialFourWindow(s,g,o,i,kind) {
      let row = o.inventory[i];
      let f = row.four;
      let path = materialPath(s,g,o.materialIds[i]);
      let before = get(path).data;
      let after = getAfter(path).data;
      let order = f.order;
      let oldLots = before.lots.size() > 4 ? before.lots[f.offset:f.offset + 4] : paddedFour(before.lots);
      let newLots = after.lots.size() > 4 ? after.lots[f.offset:f.offset + 4] : after.lots.size() == 3 ? after.lots.concat([oldLots[3]]) : after.lots;
      let day = int((request.time + duration.value(7,'h')).date().toMillis() / 86400000);
      let active = fourActive(newLots,order,day);
      return after.lots.size() == before.lots.size() && newLots.size() == 4 && row.keys().hasOnly(['materialId','revision','needed','lot0Id','lot1Id','take0','take1','shortage','ingredientCostBaht','packagingCostCents','costRank','four']) &&
        f.keys().hasOnly(['ids','order','takes','offset']) &&
        (before.lots.size() > 4 ? validHistoryWindow(before,after,row) : !('offset' in f)) &&
        (kind != 'sale' || row.materialId in o.multiIds) &&
        (o.lines.size() <= 4 || row.needed == finalMultiNeed(s,g,o,row.materialId)) &&
        f.ids == [oldLots[0].id,oldLots[1].id,oldLots[2].id,oldLots[3].id] &&
        order.size() == 4 && order.toSet().size() == 4 && order.hasOnly([0,1,2,3]) && f.takes.size() == 4 &&
        row.materialId == o.materialIds[i] && !before.deleted &&
        row.revision == before.revision && after.lastOpId == o.opId && after.lastOpKind == kind &&
        row.costRank == before.costRank && (i == 0 || o.inventory[i - 1].costRank < row.costRank) &&
        row.lot0Id == f.ids[0] && row.lot1Id == f.ids[1] && row.take0 == f.takes[0] && row.take1 == f.takes[1] &&
        boundedInt(row.needed,0,1000000000) && row.shortage == row.needed - fourSum(f.takes) && o.approvedShortages[row.materialId] == row.shortage &&
        row.ingredientCostBaht == (before.inventoryType == 'ingredient' ? (row.needed / 100.0) * before.unitCost : 0) &&
        row.packagingCostCents == (before.inventoryType == 'packaging' ? int(((fourSum(f.takes) / 100.0) * before.unitCost) * 100.0 + 0.5) : 0) && validPackageFor(o,before,row.materialId) &&
        after.activeLotId == (active >= 0 ? oldLots[active].id : '') &&
        newLots[0].isInUse == (active == 0) && newLots[1].isInUse == (active == 1) &&
        validLot(oldLots[2],newLots[2],f.takes[2],active == 2) && validLot(oldLots[3],newLots[3],f.takes[3],active == 3);
    }
    function linkedMaterial(s,g,o,i) {
      return 'four' in o.inventory[i] ? linkedMaterialFour(s,g,o,i,'sale') : linkedMaterialTwo(s,g,o,i);
    }
    function fourActive(lots,order,day) {
      return available(lots[order[0]],day) > 0 ? order[0] : available(lots[order[1]],day) > 0 ? order[1] :
        available(lots[order[2]],day) > 0 ? order[2] : available(lots[order[3]],day) > 0 ? order[3] : -1;
    }
    function validFourAllocation(lots,next,order,takes,need,day) {
      let a = min(need,available(lots[order[0]],day));
      let b = min(need - a,available(lots[order[1]],day));
      let c = min(need - a - b,available(lots[order[2]],day));
      let d = min(need - a - b - c,available(lots[order[3]],day));
      return takes[order[0]] == a && takes[order[1]] == b && takes[order[2]] == c && takes[order[3]] == d;
    }
    // Allocation proves 0 <= take <= the trusted, bounded source quantity.
    // A deduction cannot exceed that source bound; retain the stored integer type.
    function validFourLot(before,after,take) { return after.diff(before).affectedKeys().hasOnly(['qty','isInUse']) && after.qty == before.qty - take && after.qty is int && after.qty >= 0; }
    function validFourStock(s,g,o,i,need) { return 'offset' in o.inventory[i].four ? validFourStockWindow(s,g,o,i,need) : validFourStockBase(s,g,o,i,need); }
    function validFourStockBase(s,g,o,i,need) {
      let before = resource.data;
      let after = request.resource.data;
      let row = o.inventory[i];
      let f = row.four;
      let oldLots = paddedFour(before.lots);
      let newLots = after.lots.size() == 3 ? after.lots.concat([oldLots[3]]) : after.lots;
      let day = int((request.time + duration.value(7,'h')).date().toMillis() / 86400000);
      // The mandatory Four witness checks exact source/target list lengths.
      return before.lots.size() >= 3 && before.lots.size() <= 4 && row.needed == need &&
        (o.lines.size() <= 4 || row.materialId != o.multiIds[0] || validGroupsAt(o,0)) &&
        fourBefore(oldLots,f.order[0],f.order[1]) && fourBefore(oldLots,f.order[1],f.order[2]) && fourBefore(oldLots,f.order[2],f.order[3]) &&
        after.diff(before).affectedKeys().hasOnly(['stock','revision','lastOpId','lastOpKind','lastOpIndex','lots','activeLotId']) &&
        after.revision == before.revision + 1 && after.lastOpId == o.opId && after.stock == before.stock - fourSum(f.takes) &&
        (row.shortage == 0 || before.inventoryType == 'packaging' ||
          (available(oldLots[0],day) == oldLots[0].qty && available(oldLots[1],day) == oldLots[1].qty &&
           available(oldLots[2],day) == oldLots[2].qty && available(oldLots[3],day) == oldLots[3].qty)) &&
        validFourLot(oldLots[0],newLots[0],f.takes[0]) && validFourLot(oldLots[1],newLots[1],f.takes[1]) &&
        validFourAllocation(oldLots,newLots,f.order,f.takes,need,day);
    }
    function validFourStockWindow(s,g,o,i,need) {
      let before = resource.data;
      let after = request.resource.data;
      let row = o.inventory[i];
      let f = row.four;
      let oldLots = before.lots.size() > 4 ? before.lots[f.offset:f.offset + 4] : paddedFour(before.lots);
      let newLots = after.lots.size() > 4 ? after.lots[f.offset:f.offset + 4] : after.lots.size() == 3 ? after.lots.concat([oldLots[3]]) : after.lots;
      let day = int((request.time + duration.value(7,'h')).date().toMillis() / 86400000);
      return before.lots.size() >= 3 && after.lots.size() == before.lots.size() && row.needed == need &&
        (o.lines.size() <= 4 || row.materialId != o.multiIds[0] || validGroupsAt(o,0)) &&
        fourBefore(oldLots,f.order[0],f.order[1]) && fourBefore(oldLots,f.order[1],f.order[2]) && fourBefore(oldLots,f.order[2],f.order[3]) &&
        after.diff(before).affectedKeys().hasOnly(['stock','revision','lastOpId','lastOpKind','lastOpIndex','lots','activeLotId']) &&
        after.revision == before.revision + 1 && after.lastOpId == o.opId && after.stock == before.stock - fourSum(f.takes) &&
        (row.shortage == 0 || before.inventoryType == 'packaging' ||
          (available(oldLots[0],day) == oldLots[0].qty && available(oldLots[1],day) == oldLots[1].qty &&
           available(oldLots[2],day) == oldLots[2].qty && available(oldLots[3],day) == oldLots[3].qty)) &&
        validFourLot(oldLots[0],newLots[0],f.takes[0]) && validFourLot(oldLots[1],newLots[1],f.takes[1]) &&
        validFourAllocation(oldLots,newLots,f.order,f.takes,need,day);
    }
    function validStockFacts(o,row,after,i) {
      return row.costRank == after.costRank && boundedInt(row.costRank,0,1000000000) &&
        (i == 0 || o.inventory[i - 1].costRank < row.costRank) && row.keys().hasOnly(['materialId','revision','needed','lot0Id','lot1Id','take0','take1','shortage','ingredientCostBaht','packagingCostCents','costRank']) &&
        row.lot0Id == after.lots[0].id && row.lot1Id == after.lots[1].id &&
        boundedInt(row.needed,0,1000000000) && row.shortage == row.needed - row.take0 - row.take1 &&
        o.approvedShortages[row.materialId] == row.shortage && after.stock == after.lots[0].qty + after.lots[1].qty;
    }
    function linePath(s,g,opId,i) { return /databases/$(database)/documents/shops/$(s)/generations/$(g)/orders/$(opId)/lineProofs/$(i); }
    function linkedLine(s,g,o,i) {
      let lineDoc = getAfter(linePath(s,g,o.opId,string(i))).data;
      return lineDoc.opId == o.opId && lineDoc.uid == o.uid && lineDoc.index == i;
    }
    function validBlockLineAt(data,o,d,i) {
      let l = d.lines[i];
      let m = data.menus[l.menuId];
      return l == o.lines[d.index * o.lineBlockSize + i] && validLine(m,l,o.materialIds,o.platformId,!splitGroups(o));
    }
    function validBlockLine(data,o,d,i) { return i >= d.lines.size() || validBlockLineAt(data,o,d,i); }
    function lineFormula(l) {
      let choices = l.options;
      let a = choices.size() > 0 ? choices[0] : {'definition':{'recipe':{}},'qty':0};
      let b = choices.size() > 1 ? choices[1] : {'definition':{'recipe':{}},'qty':0};
      return [l.catalog.recipe,a.definition.recipe,a.qty,b.definition.recipe,b.qty,l.qty];
    }
    function formulaNeed(f,id) {
      return (f[0].get(id,0) + f[1].get(id,0) * f[2] + f[3].get(id,0) * f[4]) * f[5];
    }
    function validMultiNeedAt(ids,totals,previous,formulas,i) {
      return i >= ids.size() || totals[ids[i]] == previous.get(ids[i],0) + formulaNeed(formulas[0],ids[i]) +
        (formulas.size() > 1 ? formulaNeed(formulas[1],ids[i]) : 0);
    }
    function validLineNeedsFrom(o,d,previous) {
      let ids = o.multiIds;
      let totals = d.multiNeeds;
      let formulas = d.lines.size() > 1 ? [lineFormula(d.lines[0]),lineFormula(d.lines[1])] : [lineFormula(d.lines[0])];
      return totals.keys().hasOnly(ids) &&
        validMultiNeedAt(ids,totals,previous,formulas,0) && validMultiNeedAt(ids,totals,previous,formulas,1) && validMultiNeedAt(ids,totals,previous,formulas,2) &&
        validMultiNeedAt(ids,totals,previous,formulas,3) && validMultiNeedAt(ids,totals,previous,formulas,4);
    }
    function validLineDoc(s,g,opId,index,d) {
