      return !exists(productionPath(s,g,p.opId)) &&
        ((id == p.outputId && validProductionOutput(p)) || (id != p.outputId && validProductionInput(s,g,id,p)));
    }
    function productionShopGuard(s) {
      let p = getAfter(productionPath(s,resource.data.generation,request.resource.data.lastOpId)).data;
      return !exists(productionPath(s,resource.data.generation,p.opId)) && p.shopRevision == request.resource.data.revision &&
        request.resource.data.revision == resource.data.revision + 1 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revision','lastOpId','lastOpKind']);
    }
    match /shops/{s} {
      allow read: if signedIn();
      allow update: if (request.resource.data.get('lastOpKind','sale') == 'produce' && productionShopGuard(s)) || (request.resource.data.get('lastOpKind','sale') == 'cancel' && cancelShopGuard(s)) || (request.resource.data.get('lastOpKind','sale') == 'sale' && shopGuard(s));
      match /generations/{g}/orders/{id} {
        allow read: if active(s,g);
        allow create: if validSale(s,g,request.resource.data,id);
        allow update: if cancelSaleGuard(s,g,id);
        match /lineProofs/{index} {
          allow read: if active(s,g);
          allow create: if validLineDoc(s,g,id,index,request.resource.data);
        }
        match /inventoryProofs/{index} {
          allow read: if active(s,g);
          allow create: if validWitness(s,g,id,index,request.resource.data);
        }
      }
      match /generations/{g}/cancellations/{id} {
        allow read: if active(s,g);
        allow create: if validCancellation(s,g,id,request.resource.data);
        match /proofs/{index} {
          allow read: if active(s,g);
          allow create: if validCancelProof(s,g,id,index,request.resource.data);
        }
      }
      match /generations/{g}/productions/{id} {
        allow read: if active(s,g);
        allow create: if validProduction(s,g,id,request.resource.data);
        match /inputProofs/{index} {
          allow read: if active(s,g);
          allow create: if validProductionProof(s,g,id,index,request.resource.data);
        }
      }
      match /generations/{g}/materials/{id} {
        allow read: if active(s,g);
        allow update: if (request.resource.data.get('lastOpKind','sale') == 'produce' && productionStockGuard(s,g,id)) || (request.resource.data.get('lastOpKind','sale') == 'cancel' && ((resource.data.lots.size() == 2 && validReturn(s,g,id)) || (resource.data.lots.size() >= 3 && validReturnFour(s,g,id)))) || (request.resource.data.get('lastOpKind','sale') == 'sale' && stockGuard(s,g,id));
      }
      match /generations/{g}/menus/{id} { allow read: if active(s,g); }
      match /generations/{g}/platforms/{id} { allow read: if active(s,g); }
      match /generations/{g}/catalog/{id} { allow read: if active(s,g); }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
