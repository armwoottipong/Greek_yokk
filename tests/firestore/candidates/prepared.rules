      let ids=[c[0].id,c[1].id,c[2].id,c[3].id];
      let q=n.lotQty;
      return n.lastOpIndex==0 && row.materialId==b.id && row.revision==b.revision &&
        row.keys().hasOnly(['materialId','revision','mode','counts','requestedQ','reason','note','lossCents','activeLotId','zeroActiveIds']) &&
        row.reason is string && row.reason.size()<=200 && row.note is string && row.note.size()<=1000 &&
        n.diff(b).affectedKeys().hasOnly(['stock','lotQty','activeLotId','zeroActiveIds','allocationIds','slotIds','lastStockInDay','expiryDay','revision','lastOpId','lastOpKind','lastOpIndex']) &&
        integer(counts.size(),1,4) && ids[0:counts.size()].toSet().size()==counts.size() &&
        countCell(b.lotQty,q,c[0]) && (counts.size()<2 || countCell(b.lotQty,q,c[1])) && (counts.size()<3 || countCell(b.lotQty,q,c[2])) && (counts.size()<4 || countCell(b.lotQty,q,c[3])) &&
        q._==0 && q.diff(b.lotQty).affectedKeys().hasOnly(ids) && integer(n.stock,0,1000000000) && n.stock==b.stock+c[0].to-c[0].from+c[1].to-c[1].from+c[2].to-c[2].from+c[3].to-c[3].from &&
        n.zeroActiveIds==b.zeroActiveIds.removeAll(ids) && row.activeLotId==n.activeLotId && row.zeroActiveIds==n.zeroActiveIds;
    }
    function inventoryCountFlags(b,n,row) {
      return row.mode=='waste' ? wasteState(b,n,row) : row.mode=='count' && row.requestedQ==0 && row.lossCents==0 && countDates(b,n) &&
        (n.stock==0 || (b.zeroActiveIds.size()==0 ? b.activeLotId=='' || n.lotQty[b.activeLotId]==0 || n.activeLotId==b.activeLotId :
          b.activeLotId=='' && b.zeroActiveIds.size()==1 && originalFlag(b,n.activeLotId) || cancelFlags(b,n,originalFlag(b,n.activeLotId))));
    }
    function inventoryCountIndex(b,n,row) {
      let zero={'id':'_','from':0,'to':0};
      let c=row.counts.concat([zero,zero,zero]);
      return countIndex(b,n,row.mode,[c[0].id,c[1].id,c[2].id,c[3].id]);
    }
    function inventorySwitch(b,n,o) {
      let lot=b.lots[o.lotId];
      return o.materialRevision==b.revision && n.lastOpIndex==0 && o.lotId in b.lotIds &&
        n.diff(b).affectedKeys().hasOnly(['activeLotId','zeroActiveIds','allocationIds','slotIds','lastStockInDay','expiryDay','revision','lastOpId','lastOpKind','lastOpIndex']) &&
        (b.lotQty[o.lotId]>0 ? n.activeLotId==o.lotId : b.stock==0 ? n.activeLotId=='' : n.activeLotId in b.lotIds && b.lotQty[n.activeLotId]>0 && firstReturned(n)) &&
        n.zeroActiveIds==(b.lotQty[o.lotId]==0 ? [o.lotId] : []) && n.lastStockInDay==lot.receiveDay && n.expiryDay==lot.expiryDay;
    }
    function inventoryProduceInput(b,n,o,r,i) {
      let row=o.inputs[i];
      return b.inventoryType=='ingredient' && n.lastOpIndex==i &&
        integer(row.needed,1,1000000000) && row.needed==int((r.quantities[i] / 100.0)*(o.qtyQ / float(r.yieldQ))*100.0+0.5) &&
        row.shortage==0 && row.take==row.needed &&
        n.diff(b).affectedKeys().hasOnly(['stock','lotQty','zeroActiveIds','activeLotId','lastStockInDay','expiryDay','revision','lastOpId','lastOpKind','lastOpIndex']) && summaryStock(b,n,row,inventoryDay());
    }
    function inventoryProduceInputCost(b,o,i) {
      let row=o.inputs[i];
      return row.materialId==b.id && row.revision==b.revision && row.costRank==b.costRank &&
        row.keys().hasOnly(['materialId','revision','costRank','needed','take','shortage','ingredientCostBaht','packagingCostCents','lotIds','lotTakes']) &&
        row.packagingCostCents==0 && row.ingredientCostBaht==(row.needed / 100.0)*b.unitCost && row.lotIds==b.allocationIds;
    }
    function inventoryProduceOutput(b,n,o) {
      return b.inventoryType=='ingredient' && o.outputRevision==b.revision && n.lastOpIndex==2 &&
        n.diff(b).affectedKeys().hasOnly(['stock','unitCost','lots','lotIds','lotQty','allocationIds','slotIds','activeLotId','revision','lastOpId','lastOpKind','lastOpIndex']) &&
        integer(n.stock,1,1000000000) && n.stock==b.stock+o.qtyQ && numberIn(n.unitCost,0,100000) &&
        n.unitCost==((b.stock / 100.0)*b.unitCost+o.rawCostBaht) / (b.stock / 100.0+o.qtyQ / 100.0) &&
        n.lotQty.diff(b.lotQty).affectedKeys().hasOnly([o.lotId]) && n.lotQty[o.lotId]==o.qtyQ && n.lots.diff(b.lots).affectedKeys().hasOnly([o.lotId]);
    }
    function inventoryProduceLot(b,n,o) {
      let r=b.productionRecipe;
      let stock={'lotId':o.lotId,'qtyQ':o.qtyQ,'unitCost':o.rawCostBaht / (o.qtyQ / 100.0),'packCostCents':b.packCostCents,'receiveDay':o.receiveDay,'expiryDay':o.expiryDay,'note':o.note,'lotCreatedAtISO':o.lotCreatedAtISO,'opId':o.opId};
      return integer(r.yieldQ,1,1000000000) && r.quantities.size()==o.materialIds.size() &&
        o.rawCostBaht==o.inputs[0].ingredientCostBaht+(o.inputs.size()==2 ? o.inputs[1].ingredientCostBaht : 0) && newStockLot(b,n,stock);
    }
    function inventoryState(b,n,o,frame) {
      return o.kind=='stock_in' ? inventoryStockState(b,n,o) : o.kind=='package_stock_in' ? inventoryPackageState(b,n,o) :
        o.kind=='stock_count' ? inventoryCount(b,n,o) : o.kind=='switch_lot' ? inventorySwitch(b,n,o) :
        b.id==o.outputId ? inventoryProduceOutput(b,n,o) : inventoryProduceInput(b,n,o,frame.before[o.outputId].productionRecipe,o.materialIds[0]==b.id ? 0 : 1);
    }
    function inventoryLot(b,n,o) {
      return o.kind=='stock_in' ? inventoryStockLot(b,n,o) : o.kind=='package_stock_in' ? inventoryPackageLot(b,n,o) :
        o.kind=='stock_count' ? inventoryCountFlags(b,n,o.rows[0]) : o.kind=='switch_lot' ? true : b.id==o.outputId ? inventoryProduceLot(b,n,o) : inventoryProduceInputCost(b,o,o.materialIds[0]==b.id?0:1);
    }
    function inventoryIndex(b,n,o) {
      return o.kind in ['stock_in','package_stock_in'] || o.kind=='produce' && n.id==o.outputId ? validIndex(n) : o.kind=='stock_count' ? inventoryCountIndex(b,n,o.rows[0]) : o.kind=='switch_lot' ? cancelIndex(n) : true;
    }
    function inventoryProof(s,g,id,index,position,d) {
      let p=get(inventoryPath(s,g,id)).data;
      let step=int(index);
      let j=int(position);
      let frame=get(inventoryStepPath(s,g,id,step)).data;
      let o=frame.command;
      let material=p.materialIds[int(j / 3)];
      let b=d.before;
      let n=d.after;
      return inventoryCurrent(s,g,p) && integer(step,0,5) && string(step)==index && step<p.stepCount && integer(j,0,p.materialIds.size()*3-1) && string(j)==position &&
        d.keys().hasOnly(['before','after']) && b==frame.before[material] && n==frame.after[material] &&
        (j==0 || get(inventoryProofPath(s,g,id,step,j-1)).data.after==frame.after[p.materialIds[int((j-1) / 3)]]) &&
        (!inventoryTouched(o,material) ? n==b : !b.deleted && n.revision==b.revision+1 && n.lastOpId==id && n.lastOpKind==o.kind &&
          (j%3==0 ? inventoryState(b,n,o,frame) : j%3==1 ? inventoryLot(b,n,o) : inventoryIndex(b,n,o)));
    }
    function inventoryFinalMaterial(s,g,id) {
      let n=request.resource.data;
      let p=get(inventoryPath(s,g,n.lastOpId)).data;
      let state=get(inventoryStepPath(s,g,n.lastOpId,p.stepCount-1)).data.after[id];
      let root=rootAfter(s);
      let i=n.lastOpIndex;
      return writable(s,g) && p.uid==request.auth.uid && integer(i,0,5) && p.materialIds[i]==id && p.initial[id]==resource.data &&
        root.lastOpId==p.opId && root.lastOpKind=='inventory_batch' && root.revision==p.rootRevision+1 && p.businessDay==inventoryDay() &&
        n.revision==resource.data.revision+1 && n.diff(state).affectedKeys().hasOnly(['revision','lastOpId','lastOpKind','lastOpIndex']);
    }
    function inventoryFinalTouched(s,g,id,p,i) {
      let key=i<p.materialIds.size() ? p.materialIds[i] : '_';
      let m=i<p.materialIds.size() ? getAfter(materialPath(s,g,key)).data : {};
      return i>=p.materialIds.size() || m.lastOpId==id && m.lastOpKind=='inventory_batch' && m.lastOpIndex==i;
    }
    function inventoryRoot(s) {
      let b=resource.data;
      let n=request.resource.data;
      let p=get(inventoryPath(s,b.generation,n.lastOpId)).data;
      let o=getAfter(operationPath(s,b.generation,n.lastOpId)).data;
      return signedIn() && b.status=='active' && p.uid==request.auth.uid && p.rootRevision==b.revision && p.businessDay==inventoryDay() &&
        n.diff(b).affectedKeys().hasOnly(['revision','lastOpId','lastOpKind']) && n.revision==b.revision+1 &&
        o.kind=='inventory_batch' && o.opId==n.lastOpId && o.uid==request.auth.uid && o.shopRevision==n.revision &&
        get(inventoryProofPath(s,b.generation,p.opId,p.stepCount-1,p.materialIds.size()*3-1)).data.after==get(inventoryStepPath(s,b.generation,p.opId,p.stepCount-1)).data.after[p.materialIds[p.materialIds.size()-1]] &&
        inventoryFinalTouched(s,b.generation,p.opId,p,0) && inventoryFinalTouched(s,b.generation,p.opId,p,1) && inventoryFinalTouched(s,b.generation,p.opId,p,2) &&
        inventoryFinalTouched(s,b.generation,p.opId,p,3) && inventoryFinalTouched(s,b.generation,p.opId,p,4) && inventoryFinalTouched(s,b.generation,p.opId,p,5);
    }
    function inventoryOperation(s,g,id,o) {
      let p=get(inventoryPath(s,g,id)).data;
      let root=rootAfter(s);
      return writable(s,g) && o.keys().hasOnly(['schemaVersion','kind','status','opId','uid','createdAt','beforeShopRevision','shopRevision','businessDay','stepCount','materialIds']) &&
        o.schemaVersion==2 && o.kind=='inventory_batch' && o.status=='committed' && o.opId==id && o.uid==request.auth.uid && o.createdAt==request.time &&
        o.beforeShopRevision==p.rootRevision && o.shopRevision==p.rootRevision+1 && o.businessDay==p.businessDay && o.stepCount==p.stepCount && o.materialIds==p.materialIds &&
        root.lastOpId==id && root.lastOpKind=='inventory_batch' && root.revision==o.shopRevision;
    }

    // Preparation lifecycle. Final business commits use their existing mandatory
    // proof, so the full sale retains its twenty-dependency envelope.
    function preparationPath(s,g,id,kind) {
      let prefix=kind=='sale_set' ? 'sale_' : kind=='platform' ? 'platform_' : 'inventory_';
      return /databases/$(database)/documents/shops/$(s)/generations/$(g)/preparations/$(prefix+id);
    }
    function preparationReceipt(s,g,m) { return m.kind=='sale_set' ? orderPath(s,g,m.opId) : operationPath(s,g,m.opId); }
    function preparationCritical(s,g,m) {
      return m.kind=='sale_set' ? preparedPath(s,g,m.opId,'0') : m.kind=='platform' ? platformProofPath(s,g,m.opId,m.proofCount-1) : inventoryProofPath(s,g,m.opId,m.stepCount-1,m.proofCount-1);
    }
    function preparationOpen(s,g,id,kind) {
      let m=getAfter(preparationPath(s,g,id,kind)).data;
      // Immutable identity is checked once at manifest creation/path binding.
      return m.state=='open' && m.uid==request.auth.uid;
    }
    function preparationDimensions(s,g,id,count,steps) {
      let m=getAfter(preparationPath(s,g,id,'inventory_batch')).data;
      return m.proofCount==count && m.stepCount==steps;
    }
    function preparationCreate(s,g,id,m) {
      return active(s,g) && m.keys().hasOnly(['kind','opId','uid','state','createdAt','lifetimeDays','proofCount','stepCount','materialCount']) &&
        m.kind in ['sale_set','inventory_batch','platform'] && m.opId is string && m.opId.matches('^[A-Za-z0-9_-]{1,200}$') &&
        id==(m.kind=='sale_set' ? 'sale_' : m.kind=='platform' ? 'platform_' : 'inventory_')+m.opId &&
        m.uid==request.auth.uid && m.state=='open' && m.createdAt==request.time && m.lifetimeDays==7 && !exists(preparationReceipt(s,g,m)) &&
        (m.kind=='inventory_batch' ? integer(m.stepCount,1,6) && integer(m.materialCount,1,6) && m.proofCount==m.materialCount*3 :
          m.stepCount==0 && m.materialCount==0 && integer(m.proofCount,1,m.kind=='sale_set'?3:32));
    }
    function preparationClose(s,g) {
      let b=resource.data;
      let n=request.resource.data;
      let receipt=preparationReceipt(s,g,b);
      return active(s,g) && b.state=='open' && n.diff(b).affectedKeys().hasOnly(['state','closedAt']) && n.closedAt==request.time &&
        (n.state=='committed' ? request.auth.uid==b.uid && getAfter(receipt).data.kind==b.kind && getAfter(receipt).data.opId==b.opId && getAfter(receipt).data.uid==b.uid :
          ((n.state=='abandoned' && request.auth.uid==b.uid) || (n.state=='expired' && request.time>=b.createdAt+duration.value(7,'d'))) &&
          (!existsAfter(receipt) || getAfter(receipt).data.kind!=b.kind || getAfter(receipt).data.uid!=b.uid) && !existsAfter(preparationCritical(s,g,b)));
    }
    function preparationCleanup(s,g,id,kind,retainCommitted) {
      let m=getAfter(preparationPath(s,g,id,kind)).data;
      return active(s,g) && m.kind==kind && m.opId==id && m.state in ['abandoned','expired','committed'] &&
        (!retainCommitted || m.state!='committed') && (m.uid==request.auth.uid || request.time>=m.createdAt+duration.value(7,'d'));
    }
    function preparationCleanupProof(s,g,id,kind,index,step) {
      let m=getAfter(preparationPath(s,g,id,kind)).data;
      let i=int(index);
      return preparationCleanup(s,g,id,kind,false) && string(i)==index && integer(i,0,m.proofCount-1) &&
        (kind!='inventory_batch' || integer(int(step),0,m.stepCount-1) && string(int(step))==step);
    }
    match /shops/{s} {
      allow read: if signedIn();
      allow update: if request.resource.data.lastOpKind == 'sale_set' && validRoot(s);
      allow update: if request.resource.data.lastOpKind != 'sale_set' && (
        request.resource.data.lastOpKind == 'stock_in' && stockRoot(s) ||
        request.resource.data.lastOpKind == 'catalog' && catalogRoot(s) ||
        request.resource.data.lastOpKind == 'cancel' && cancelRoot(s) ||
        request.resource.data.lastOpKind == 'produce' && produceRoot(s) ||
        request.resource.data.lastOpKind == 'switch_lot' && switchRoot(s) ||
        request.resource.data.lastOpKind == 'stock_count' && countRoot(s) ||
        request.resource.data.lastOpKind == 'menu' && menuRoot(s) ||
        request.resource.data.lastOpKind == 'addon' && addonRoot(s) ||
        request.resource.data.lastOpKind == 'group' && groupRoot(s));
      allow update: if request.resource.data.lastOpKind == 'material_metadata' && materialMetadataRoot(s);
      allow update: if request.resource.data.lastOpKind == 'material_create' && materialCreateRoot(s);
      allow update: if request.resource.data.lastOpKind == 'material_archive' && materialArchiveRoot(s);
      allow update: if request.resource.data.lastOpKind == 'material_enrol' && materialEnrolRoot(s);
      allow update: if request.resource.data.lastOpKind == 'production_recipe' && productionRecipeRoot(s);
      allow update: if request.resource.data.lastOpKind == 'material_measure' && materialMeasureRoot(s);
      allow update: if request.resource.data.lastOpKind == 'material_type' && materialTypeRoot(s);
      allow update: if request.resource.data.lastOpKind == 'package_stock_in' && packageStockRoot(s);
      allow update: if request.resource.data.lastOpKind == 'platform' && platformRoot(s);
      allow update: if request.resource.data.lastOpKind == 'material_details' && materialDetailsRoot(s);
      allow update: if request.resource.data.lastOpKind == 'inventory_batch' && inventoryRoot(s);
      match /generations/{g}/operations/{id} {
        allow read: if active(s,g);
        allow create: if request.resource.data.kind == 'stock_in' && stockOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'catalog' && catalogOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'cancel' && cancelOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'produce' && produceOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'switch_lot' && switchOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'stock_count' && countOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'menu' && menuOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'addon' && addonOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'group' && groupOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'material_metadata' && materialMetadataOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'material_create' && materialCreateOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'material_archive' && materialArchiveOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'material_enrol' && materialEnrolOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'production_recipe' && productionRecipeOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'material_measure' && materialMeasureOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'material_type' && materialTypeOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'package_stock_in' && packageStockOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'platform' && platformOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'material_details' && materialDetailsOperation(s,g,id,request.resource.data);
        allow create: if request.resource.data.kind == 'inventory_batch' && inventoryOperation(s,g,id,request.resource.data);
        match /referenceProofs/{index} {
          allow read: if active(s,g);
          allow create: if catalogReferenceProof(s,g,id,index,request.resource.data);
          allow create: if menuShapeProof(s,g,id,index,request.resource.data);
          allow create: if groupShapeProof(s,g,id,index,request.resource.data);
        }
      }
      match /generations/{g}/preparations/{id} {
        allow read: if active(s,g);
        allow create: if preparationCreate(s,g,id,request.resource.data);
        allow update: if preparationClose(s,g);
      }
      match /generations/{g}/preparedInventory/{id} {
        allow read: if active(s,g);
        allow create: if inventoryProposal(s,g,id,request.resource.data);
        allow delete: if preparationCleanup(s,g,id,'inventory_batch',true);
        match /steps/{index} {
          allow read: if active(s,g);
          allow create: if inventoryStep(s,g,id,index,request.resource.data);
          allow delete: if preparationCleanup(s,g,id,'inventory_batch',true);
          match /proofs/{position} {
            allow read: if active(s,g);
            allow create: if inventoryProof(s,g,id,index,position,request.resource.data);
            allow delete: if preparationCleanupProof(s,g,id,'inventory_batch',position,index);
          }
        }
      }
      match /generations/{g}/preparedPlatforms/{id} {
        allow read: if active(s,g);
        allow create: if platformProposal(s,g,id,request.resource.data);
        allow delete: if preparationCleanup(s,g,id,'platform',true);
        match /columnProofs/{index} {
          allow read: if active(s,g);
          allow create: if platformProof(s,g,id,index,request.resource.data);
          allow delete: if preparationCleanupProof(s,g,id,'platform',index,'0');
        }
      }
      match /generations/{g}/preparedSales/{id}/lineProofs/{index} {
        allow read: if active(s,g);
        allow create: if request.resource.data.lines.size()==1 && preparedWrite(s,g,id,index,request.resource.data);
        allow update: if resource.data.uid==request.auth.uid && preparedWrite(s,g,id,index,request.resource.data);
        allow delete: if preparationCleanupProof(s,g,id,'sale_set',index,'0');
      }
      match /generations/{g}/orders/{id} {
        allow read: if active(s,g);
        allow create: if validOrder(s,g,id,request.resource.data);
        allow update: if cancelOrder(s,g,id);
        match /lineProofs/{index} {
          allow read: if active(s,g);
          allow create: if false;
        }
      }
      match /generations/{g}/materials/{id} {
        allow read: if active(s,g);
        allow update: if request.resource.data.lastOpKind == 'sale_set' && validMaterial(s,g,id);
        allow update: if request.resource.data.lastOpKind != 'sale_set' && (
          request.resource.data.lastOpKind == 'stock_in' && stockMaterial(s,g,id) ||
          request.resource.data.lastOpKind == 'catalog' && catalogMaterial(s,g,id) ||
          request.resource.data.lastOpKind == 'cancel' && cancelMaterial(s,g,id) ||
          request.resource.data.lastOpKind == 'produce' && request.resource.data.lastOpIndex < 2 && produceInput(s,g,id) ||
          request.resource.data.lastOpKind == 'produce' && request.resource.data.lastOpIndex == 2 && produceOutput(s,g,id) ||
          request.resource.data.lastOpKind == 'switch_lot' && switchMaterial(s,g,id) ||
          request.resource.data.lastOpKind == 'stock_count' && countMaterial(s,g,id) ||
          request.resource.data.lastOpKind == 'menu' && menuMaterial(s,g,id) ||
          request.resource.data.lastOpKind == 'addon' && addonMaterial(s,g,id) ||
          request.resource.data.lastOpKind == 'group' && groupMaterial(s,g,id));
        allow create: if request.resource.data.lastOpKind == 'material_create' && materialCreateMaterial(s,g,id);
        allow update: if request.resource.data.lastOpKind == 'material_metadata' && materialMetadataMaterial(s,g,id);
        allow update: if request.resource.data.lastOpKind == 'material_archive' && materialArchiveMaterial(s,g,id);
        allow update: if request.resource.data.lastOpKind == 'material_enrol' && materialEnrolMaterial(s,g,id);
        allow update: if request.resource.data.lastOpKind == 'production_recipe' && productionRecipeMaterial(s,g,id);
        allow update: if request.resource.data.lastOpKind == 'material_measure' && materialMeasureMaterial(s,g,id);
        allow update: if request.resource.data.lastOpKind == 'material_type' && materialTypeMaterial(s,g,id);
        allow update: if request.resource.data.lastOpKind == 'package_stock_in' && packageStockMaterial(s,g,id);
        allow update: if request.resource.data.lastOpKind == 'material_details' && materialDetailsMaterial(s,g,id);
        allow update: if request.resource.data.lastOpKind == 'inventory_batch' && inventoryFinalMaterial(s,g,id);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
